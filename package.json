{
  "name": "mediaharbor",
  "version": "2.2.0",
  "scripts": {
    "dev": "vite",
    "build:react": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "tauri:icon": "npx tauri icon src/assets/MediaHarbor_Logo.svg -o src/app/icons",
    "tauri:dev": "concurrently \"npx vite dev\" \"cd src/app && cargo tauri dev\"",
    "tauri:build": "npm run build:react && cd src/app && APPIMAGE_EXTRACT_AND_RUN=1 cargo tauri build --no-sign",
    "tauri:build:linux": "npm run build:react && cd src/app && APPIMAGE_EXTRACT_AND_RUN=1 cargo tauri build --no-sign --bundles deb,rpm,appimage",
    "tauri:build:win": "npm run build:react && cd src/app && cargo tauri build --no-sign --bundles msi,nsis",
    "tauri:build:mac": "npm run build:react && cd src/app && cargo tauri build --no-sign --bundles dmg,app",
    "tauri:build:mac:x64": "npm run build:react && cd src/app && cargo tauri build --no-sign --target x86_64-apple-darwin --bundles dmg",
    "tauri:build:mac:arm64": "npm run build:react && cd src/app && cargo tauri build --no-sign --target aarch64-apple-darwin --bundles dmg"
  },
  "keywords": [],
  "author": "CrossyAtom46",
  "license": "GPL-3.0-or-later",
  "description": "MediaHarbor",
  "homepage": "https://mediaharbor.org",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
